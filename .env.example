# 운영 서버 /home/ubuntu/app/.env 에 들어가야 하는 키 (docker-compose.yml이 ${...}로 참조).
# 값은 넣지 않는다. 빈 값이 있으면 deploy.sh가 배포를 멈춘다(CTF_*·AUTH_* 선택 키 제외).

# MySQL
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# Redis (redis-server --requirepass 와 backend가 같은 값을 쓴다)
REDIS_PASSWORD=

# JWT
JWT_SECRET=

# Spring Security 기본 계정 (application.yml에 기본값 없음)
SPRING_SECURITY_USER_NAME=
SPRING_SECURITY_USER_PASSWORD=

# S3
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_S3_ACCESS_KEY=
AWS_S3_SECRET_KEY=

# SES
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=

# 선택: CTF 인스턴스 서브도메인 프록시 (inst-{uuid}.{도메인}). 비우면 프록시가 꺼진다.
CTF_INSTANCE_BASE_DOMAIN=nimda.kr
# 선택: CTF 서버(EC2) 인스턴스 게이트웨이 "사설IP:포트" (VPC peering). 비우면 결과 host:port로 직접 붙는다.
# 웹과 CTF 서버가 다른 호스트면 필수다. (docs/issue/instance-split-host-access-issue.md)
# 포트까지 적는다. 포트를 빼면 80번으로 붙어서 게이트웨이(8088)에 안 닿는다.
CTF_INSTANCE_GATEWAY=
# 선택: 로그인 쿠키를 inst-*.{도메인}에도 보낸다. 비우면 host-only. (RB-0001 주의사항 참고)
AUTH_COOKIE_DOMAIN=nimda.kr
